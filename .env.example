# Use a separate test project. Keep its service-account file outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-test-service-account.json
KIRA_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Set a Gemini model that is available to your own API project.
KIRA_CHAT_MODEL=
KIRA_REQUIRE_AUTH=true
ENABLE_RAG=true
ENABLE_SESSION_CACHE=true
ENABLE_SAFETY_ROUTER=true
KIRA_DEBUG_CHAT=false
